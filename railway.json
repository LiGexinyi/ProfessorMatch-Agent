build:
  dockerfile: Dockerfile
run:
  startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
  envVars:
    - key: DATABASE_URL
      value: "sqlite+aiosqlite:///./professor_match.db"
    - key: LLM_API_KEY
      sync: false
    - key: LLM_API_URL
      value: "https://api.openai.com/v1/chat/completions"
    - key: LLM_MODEL
      value: "gpt-4o-mini"
    - key: SECRET_KEY
      generateValue: true
